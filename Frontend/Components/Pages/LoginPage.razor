@namespace Frontend.Components.Pages

@page "/login"
@attribute [AllowAnonymous]

@using Shared.Contracts.Auth.Requests

@inject NavigationManager NavigationManager
@inject ICustomAuthenticationStateProvider AuthenticationStateProvider

<PageTitle>LoginPage</PageTitle>

<div class="flex flex-col items-center">
    <h3 class="text-2xl font-bold mb-4">LoginPage</h3>

    <EditForm class="w-[300px]" Model="@loginModel" OnValidSubmit="@HandleLogin">
        <DataAnnotationsValidator/>
        <div class="mb-6">
            <label for="email" class="block text-sm font-medium mb-1">Email</label>
            <Input
                Class="w-full"
                Id="email"
                @bind-Value="loginModel.Email"
                Type="email"
                Disabled="IsSubmitting"/>
            <ValidationMessage For="@(() => loginModel.Email)" class="text-sm text-red mt-1"/>
        </div>

        <div class="mb-7">
            <label for="password" class="block text-sm font-medium mb-1">Password</label>
            <Input
                Class="w-full"
                Id="password"
                @bind-Value="loginModel.Password"
                Type="password"
                Disabled="IsSubmitting"/>
            <ValidationMessage For="@(() => loginModel.Password)" class="text-sm text-red mt-1"/>
        </div>

        <div class="mb-5">
            <Checkbox
                Id="keepLoggedIn"
                Class="mr-2"
                Checked="@KeepLoggedIn"
                CheckedChanged="@(value => KeepLoggedIn = value)"
                Disabled="IsSubmitting"/>
            <label for="keepLoggedIn" class="text-sm font-medium">Keep me logged in</label>
        </div>

        <div class="flex justify-center">
            <Button Type="submit" IsLoading="IsSubmitting" Disabled="IsSubmitting">
                LoginPage
            </Button>
        </div>
    </EditForm>

    @if (!string.IsNullOrEmpty(Message))
    {
        <div class="mt-6 text-red">@Message</div>
    }

    <div class="mt-4 text-sm">
        <span>Don't have an account? </span>
        <a href="/register" class="text-primary-500 hover:text-secondary-600 underline">RegisterPage here</a>
    </div>
</div>


@code {
    private LoginModel loginModel = new();
    private string Message = string.Empty;
    private bool IsSubmitting = false;
    private bool KeepLoggedIn = false;
    private bool IsAuthenticated => AuthenticationStateProvider.Identity != null;

    protected override void OnInitialized()
    {
        CheckAuthentication();
    }

    protected override void OnParametersSet()
    {
        CheckAuthentication();
    }

    private void CheckAuthentication()
    {
        if (IsAuthenticated != null)
        {
            NavigationManager.NavigateTo("/");
        }
    }

    private async Task HandleLogin()
    {
        try
        {
            IsSubmitting = true;
            var loginRequest = new LoginRequest(
                loginModel.Email,
                loginModel.Password
            );

            bool isSuccess = await AuthenticationStateProvider.Login(loginRequest, KeepLoggedIn);

            if (isSuccess)
            {
                NavigationManager.NavigateTo("/");
            }
            else
            {
                Message = "Wrong email or password.";
            }
        }
        catch (Exception)
        {
            Message = "Something went wrong, please try again.";
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    public class LoginModel
    {
        [Required(ErrorMessage = "Email is required.")]
        [EmailAddress(ErrorMessage = "Invalid email format.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Password is required.")]
        public string Password { get; set; } = string.Empty;
    }

}